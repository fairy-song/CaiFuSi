# 财赋思项目环境变量配置模板
# 复制此文件为 .env.local 并填入真实的配置值

# ==================== 智谱AI配置 ====================
# 智谱AI API密钥（必需）
# 获取方式：访问 https://open.bigmodel.cn/ 注册并获取API密钥
ZHIPUAI_API_KEY=YOUR_API_KEY_HERE

# ==================== Firebase配置（必需） ====================
# 前端 Firebase 配置
# 从 Firebase 控制台获取这些值：https://console.firebase.google.com/
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 后端 Firebase Admin SDK 配置（可选）
# 如果使用 Firebase Admin SDK，请配置服务账号密钥文件路径
# FIREBASE_ADMIN_SDK_PATH=path/to/serviceAccountKey.json

# ==================== Google Gemini AI配置（可选） ====================
# 如果使用 Google Gemini AI，请配置以下项
# GEMINI_API_KEY=your_gemini_api_key

# ==================== 其他配置 ====================
# 密钥（用于会话加密等，必需）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# 开发模式（默认为true）
DEV_MODE=true

# API 基础 URL（可选，默认为 http://localhost:5001）
# REACT_APP_API_URL=http://localhost:5001/api
